<ResourceDictionary
    x:Class="NINA.RetroKiwi.Plugin.SonyCamera.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  This data template will be displayed in N.I.N.A. on the options->plugin tab with the datacontext of the TestPlugin instance  -->
    <!--  In order for this datatemplate to be picked correctly, the key has to follow the naming convention of <IPlugin.Name>_Options -->
    <!--  Furthermore the Resource Dictionary has to be exported via code behind export attributes  -->
    <DataTemplate x:Key="Sony Camera Plugin_Options">
        <StackPanel Orientation="Vertical" Margin="0,4,0,0">
            <TextBlock Text="Camera native capture cancellation" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="Use the camera's native CancelCapture call during aborts. Stability varies by camera model and Windows driver stack and can cause VCRUNTIME crashes. Disable if aborts crash NINA; enable if you need to force-stop exposures." TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"/>
            <CheckBox Content="Enable native cancel"
                      HorizontalAlignment="Left"
                      IsChecked="{Binding EnableNativeCancel, Mode=TwoWay}" />

            <TextBlock Text="USB disconnect detection (experimental)" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,4" />
            <TextBlock Text="Ask Windows to report the camera leaving the USB bus, so the plugin can stop talking to the driver immediately and reopen the camera when it comes back. Useful if the USB connection is unreliable. Unproven: on at least one machine, builds carrying this failed to open the camera where the same build without it succeeded, so leave it off unless you are testing it." TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"/>
            <CheckBox Content="Detect USB disconnects and reconnect automatically"
                      HorizontalAlignment="Left"
                      IsChecked="{Binding EnableUsbDisconnectDetection, Mode=TwoWay}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
